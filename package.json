{
  "name": "latuns-erp",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "migrate": "node scripts/migrate.js",
    "prod-daemon": "node scripts/heartbeat.js",
    "lint": "eslint",
    "electron:dev": "electron .",
    "electron:build": "electron-builder"
  },
  "build": {
    "appId": "com.latunserp.app",
    "productName": "Latuns ERP",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "files": [
      "main.js",
      "loading.html",
      "scripts/**/*",
      "package.json",
      "rejoin-as-standby.bat",
      "docker-compose.yml",
      ".env",
      "Dockerfile"
    ]
  },
  "dependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/nodemailer": "^8.0.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "html2canvas": "^1.4.1",
    "imapflow": "^1.3.3",
    "jspdf": "^4.2.0",
    "lucide-react": "^0.575.0",
    "mailparser": "^3.9.8",
    "next": "16.1.6",
    "nodemailer": "^8.0.7",
    "pg": "^8.21.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-quill-new": "^3.8.3",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.15.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.4",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  }
}
