# ===== Dependencies =====
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ===== Next.js =====
/.next/
/out/
/build

# ===== TypeScript =====
*.tsbuildinfo
next-env.d.ts

# ===== Environment (NEVER commit secrets) =====
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# ===== Database =====
*.db
*.db-journal
*.db-wal
*.db-shm
/data/

# ===== Drizzle migrations (generated, machine-specific) =====
# Keep drizzle.config.ts but ignore generated migration snapshots
/drizzle/meta/

# ===== Backups & Uploads (local data, never in git) =====
/backups/
/upload/

# ===== Syncthing (machine-specific identity, must be unique per node) =====
/syncthing-config/

# ===== Local/scratch/workspace files =====
/scratch/
/My Suggestions/
*.code-workspace
implementation_plan.md

# ===== OS Files =====
.DS_Store
Thumbs.db
desktop.ini

# ===== Debug Logs =====
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ===== Misc =====
*.pem
.vercel
