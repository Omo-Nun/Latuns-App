# Latuns ERP Environment Configuration

# PostgreSQL Database Connection
# When using Docker Compose, the hostname is the service name "db"
DATABASE_URL="postgres://postgres:postgres@db:5432/latuns"

# 64-character hex string used for zero-knowledge encryption of cluster backups.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Do NOT lose this key, or you will not be able to decrypt your backups!
ENCRYPTION_KEY="CHANGE_ME_generate_a_64_char_hex_string"

# Node Configuration
# Each machine gets a unique NODE_NAME. NODE_ROLE is "Primary" or "Secondary".
NODE_NAME="Node Alpha"
NODE_ROLE="Primary"
NODE_ENV="production"

# Network: Address or hostname of the OTHER node in the cluster
# Used for split-brain detection and automatic handover redirection.
PEER_NODE_ADDRESS="http://192.168.x.x:3000"

# Cloud Heartbeat Configuration (Optional)
# If provided, the local daemon will ping this endpoint every minute.
# HEARTBEAT_ENDPOINT="https://us-central1-your-gcp-project.cloudfunctions.net/latuns-heartbeat"
